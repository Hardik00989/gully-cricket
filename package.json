    "test:probe": "node tools/check_probe.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
